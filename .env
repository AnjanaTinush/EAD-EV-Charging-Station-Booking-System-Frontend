# EV Charging Station Frontend Configuration
# This single .env file works for all environments

# Backend Configuration
VITE_BACKEND_URL=https://localhost:7179/ #http://localhost:8080/
VITE_API_URL=api

# App Configuration
VITE_APP_NAME=EV Charging Station Management
VITE_APP_VERSION=1.0.0

# Development Features
VITE_ENABLE_PROXY_LOGS=true

# Environment Mode (development/production)
# This is automatically set by Vite, but you can override it
# VITE_MODE=development

# Production Override Example (uncomment for production):
# VITE_BACKEND_URL=https://your-production-api.com
# VITE_API_URL=https://your-production-api.com/api
# VITE_ENABLE_PROXY_LOGS=false